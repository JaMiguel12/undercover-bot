# Secrets : renseigner dans .env (jamais commité)
BOT_TOKEN=
GROQ_API_KEY=

# Modèle Groq (voir la documentation Groq pour les modèles disponibles)
GROQ_MODEL=openai/gpt-oss-120b

# Facultatif : effort de raisonnement des modèles gpt-oss (low = moins de jetons, plus rapide)
GROQ_REASONING_EFFORT=low

DATABASE_URL=sqlite+aiosqlite:///./data/undercover.db

# Délais en secondes
DESCRIPTION_TIMEOUT=60
VOTE_TIMEOUT=90
LOBBY_TIMEOUT=600
SOLO_WAIT_TIMEOUT=30

# Pause (secondes) avant la nouvelle partie automatique du mode sans élimination
RESTART_DELAY=60
